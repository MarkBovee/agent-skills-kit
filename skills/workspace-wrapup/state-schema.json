{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statePath",
    "umbrellaRepo",
    "umbrellaDeliverable",
    "umbrellaCleanAtFirstNestedTouch",
    "recovery",
    "repos"
  ],
  "properties": {
    "statePath": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "umbrellaRepo": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "umbrellaDeliverable": {
      "type": "boolean"
    },
    "umbrellaCleanAtFirstNestedTouch": {
      "$ref": "#/$defs/nullableBoolean"
    },
    "recovery": {
      "$ref": "#/$defs/recovery"
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repoEntry"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "adoptedBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localHead",
        "remoteHead"
      ],
      "properties": {
        "localHead": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remoteHead": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "branchEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ownership",
        "disposition"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownership": {
          "enum": [
            "created",
            "preexisting-used"
          ]
        },
        "disposition": {
          "enum": [
            "delete-on-wrapup",
            "preserve"
          ]
        }
      }
    },
    "worktreeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "ownership",
        "disposition"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "ownership": {
          "enum": [
            "created",
            "preexisting-used"
          ]
        },
        "disposition": {
          "enum": [
            "delete-on-wrapup",
            "preserve"
          ]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "confirmed",
        "fingerprint"
      ],
      "properties": {
        "mode": {
          "enum": [
            "normal",
            "recovered"
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "fingerprint": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "normal"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": false
              },
              "fingerprint": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "recovered"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": true
              },
              "fingerprint": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "repoEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoPath",
        "branchOfRecord",
        "remoteBranch",
        "baselineMode",
        "adoptedBaseline",
        "sourceBranch",
        "startHeadCommit",
        "expectedIntegratedTree",
        "remoteHeadWhenTreeFrozen",
        "topicBranches",
        "worktrees"
      ],
      "properties": {
        "repoPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "branchOfRecord": {
          "$ref": "#/$defs/nullableString"
        },
        "remoteBranch": {
          "$ref": "#/$defs/nullableString"
        },
        "baselineMode": {
          "enum": [
            "remote-aligned",
            "adopted-divergence",
            null
          ]
        },
        "adoptedBaseline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/adoptedBaseline"
            }
          ]
        },
        "sourceBranch": {
          "$ref": "#/$defs/nullableString"
        },
        "startHeadCommit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "expectedIntegratedTree": {
          "$ref": "#/$defs/nullableString"
        },
        "remoteHeadWhenTreeFrozen": {
          "$ref": "#/$defs/nullableString"
        },
        "topicBranches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branchEntry"
          }
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktreeEntry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "baselineMode": {
                "const": "remote-aligned"
              }
            },
            "required": [
              "baselineMode"
            ]
          },
          "then": {
            "properties": {
              "adoptedBaseline": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "baselineMode": {
                "const": "adopted-divergence"
              }
            },
            "required": [
              "baselineMode"
            ]
          },
          "then": {
            "properties": {
              "adoptedBaseline": {
                "$ref": "#/$defs/adoptedBaseline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remoteHeadWhenTreeFrozen": {
                "type": "string"
              }
            },
            "required": [
              "remoteHeadWhenTreeFrozen"
            ]
          },
          "then": {
            "properties": {
              "expectedIntegratedTree": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    }
  }
}
